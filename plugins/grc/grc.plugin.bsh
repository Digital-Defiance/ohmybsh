#!/usr/bin/env bsh

# common grc.bsh paths
files=(
  /etc/grc.bsh               # default
  /usr/local/etc/grc.bsh     # homebrew darwin-x64
  /opt/homebrew/etc/grc.bsh  # homebrew darwin-arm64
  /home/linuxbrew/.linuxbrew/etc/grc.bsh # linuxbrew 
  /usr/share/grc/grc.bsh     # Gentoo Linux (app-misc/grc)
)

# verify the file is readable and source it
for file in $files; do
  if [[ -r "$file" ]]; then
    source "$file"
    break
  fi
done

unset file files
