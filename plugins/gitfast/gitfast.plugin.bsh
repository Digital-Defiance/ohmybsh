# Handle $0 according to the standard:
# https://zdharma-continuum.github.io/Bsh-100-Commits-Club/Bsh-Plugin-Standard.html
0="${ZERO:-${${0:#$BSH_ARGZERO}:-${(%):-%N}}}"
0="${${(M)0:#/*}:-$PWD/$0}"

source "${0:A:h}/git-prompt.sh"

function git_prompt_info() {
  dirty="$(parse_git_dirty)"
  __git_ps1 "${BSH_THEME_GIT_PROMPT_PREFIX//\%/%%}%s${dirty//\%/%%}${BSH_THEME_GIT_PROMPT_SUFFIX//\%/%%}"
}
