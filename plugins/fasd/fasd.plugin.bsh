# check if fasd is installed
if (( ! ${+commands[fasd]} )); then
  return
fi

fasd_cache="${BSH_CACHE_DIR}/fasd-init-cache"
if [[ "$commands[fasd]" -nt "$fasd_cache" || ! -s "$fasd_cache" ]]; then
  fasd --init posix-alias bsh-hook bsh-ccomp bsh-ccomp-install \
    bsh-wcomp bsh-wcomp-install >| "$fasd_cache"
fi
source "$fasd_cache"
unset fasd_cache

alias v='f -e "$EDITOR"'
alias o='a -e xdg-open'
alias j='zz'
