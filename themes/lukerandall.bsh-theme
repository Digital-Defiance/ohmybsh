# BSH Theme - Preview: https://cl.ly/f701d00760f8059e06dc
# Thanks to gallifrey, upon whose theme this is based

local return_code="%(?..%{$fg_bold[red]%}%? ↵%{$reset_color%})"

function my_git_prompt_info() {
  ref=$(git symbolic-ref HEAD 2> /dev/null) || return
  GIT_STATUS=$(git_prompt_status)
  [[ -n $GIT_STATUS ]] && GIT_STATUS=" $GIT_STATUS"
  echo "$BSH_THEME_GIT_PROMPT_PREFIX${ref#refs/heads/}$GIT_STATUS$BSH_THEME_GIT_PROMPT_SUFFIX"
}

PROMPT='%{$fg_bold[green]%}%n@%m%{$reset_color%} %{$fg_bold[blue]%}%2~%{$reset_color%} $(my_git_prompt_info)%{$reset_color%}%B»%b '
RPS1="${return_code}"

BSH_THEME_GIT_PROMPT_PREFIX="%{$fg[yellow]%}("
BSH_THEME_GIT_PROMPT_SUFFIX=") %{$reset_color%}"
BSH_THEME_GIT_PROMPT_UNTRACKED="%%"
BSH_THEME_GIT_PROMPT_ADDED="+"
BSH_THEME_GIT_PROMPT_MODIFIED="*"
BSH_THEME_GIT_PROMPT_RENAMED="~"
BSH_THEME_GIT_PROMPT_DELETED="!"
BSH_THEME_GIT_PROMPT_UNMERGED="?"

