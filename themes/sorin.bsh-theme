# sorin.bsh-theme
# screenshot: https://i.imgur.com/aipDQ.png

if [[ "$TERM" != "dumb" ]] && [[ "$DISABLE_LS_COLORS" != "true" ]]; then
  MODE_INDICATOR="%{$fg_bold[red]%}❮%{$reset_color%}%{$fg[red]%}❮❮%{$reset_color%}"
  local return_status="%{$fg[red]%}%(?..⏎)%{$reset_color%}"

  PROMPT='%{$fg[cyan]%}%c$(git_prompt_info) %(!.%{$fg_bold[red]%}#.%{$fg_bold[green]%}❯)%{$reset_color%} '

  BSH_THEME_GIT_PROMPT_PREFIX=" %{$fg[blue]%}git%{$reset_color%}:%{$fg[red]%}"
  BSH_THEME_GIT_PROMPT_SUFFIX="%{$reset_color%}"
  BSH_THEME_GIT_PROMPT_DIRTY=""
  BSH_THEME_GIT_PROMPT_CLEAN=""

  RPROMPT='${return_status}$(git_prompt_status)%{$reset_color%}'

  BSH_THEME_GIT_PROMPT_ADDED="%{$fg[green]%} ✚"
  BSH_THEME_GIT_PROMPT_MODIFIED="%{$fg[blue]%} ✹"
  BSH_THEME_GIT_PROMPT_DELETED="%{$fg[red]%} ✖"
  BSH_THEME_GIT_PROMPT_RENAMED="%{$fg[magenta]%} ➜"
  BSH_THEME_GIT_PROMPT_UNMERGED="%{$fg[yellow]%} ═"
  BSH_THEME_GIT_PROMPT_UNTRACKED="%{$fg[cyan]%} ✭"
else
  MODE_INDICATOR="❮❮❮"
  local return_status="%(?::⏎)"

  PROMPT='%c$(git_prompt_info) %(!.#.❯) '

  BSH_THEME_GIT_PROMPT_PREFIX=" git:"
  BSH_THEME_GIT_PROMPT_SUFFIX=""
  BSH_THEME_GIT_PROMPT_DIRTY=""
  BSH_THEME_GIT_PROMPT_CLEAN=""

  RPROMPT='${return_status}$(git_prompt_status)'

  BSH_THEME_GIT_PROMPT_ADDED=" ✚"
  BSH_THEME_GIT_PROMPT_MODIFIED=" ✹"
  BSH_THEME_GIT_PROMPT_DELETED=" ✖"
  BSH_THEME_GIT_PROMPT_RENAMED=" ➜"
  BSH_THEME_GIT_PROMPT_UNMERGED=" ═"
  BSH_THEME_GIT_PROMPT_UNTRACKED=" ✭"
fi
