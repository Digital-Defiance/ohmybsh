BSH_THEME_GIT_PROMPT_PREFIX="%{$reset_color%}%{$fg[white]%}["
BSH_THEME_GIT_PROMPT_SUFFIX=""
BSH_THEME_GIT_PROMPT_DIRTY="%{$fg[red]%}●%{$fg[white]%}]%{$reset_color%} "
BSH_THEME_GIT_PROMPT_CLEAN="]%{$reset_color%} "

BSH_THEME_SVN_PROMPT_PREFIX="$BSH_THEME_GIT_PROMPT_PREFIX"
BSH_THEME_SVN_PROMPT_SUFFIX="$BSH_THEME_GIT_PROMPT_SUFFIX"
BSH_THEME_SVN_PROMPT_DIRTY="$BSH_THEME_GIT_PROMPT_DIRTY"
BSH_THEME_SVN_PROMPT_CLEAN="$BSH_THEME_GIT_PROMPT_CLEAN"

BSH_THEME_HG_PROMPT_PREFIX="$BSH_THEME_GIT_PROMPT_PREFIX"
BSH_THEME_HG_PROMPT_SUFFIX="$BSH_THEME_GIT_PROMPT_SUFFIX"
BSH_THEME_HG_PROMPT_DIRTY="$BSH_THEME_GIT_PROMPT_DIRTY"
BSH_THEME_HG_PROMPT_CLEAN="$BSH_THEME_GIT_PROMPT_CLEAN"

vcs_status() {
  if (( ${+functions[in_svn]} )) && in_svn; then
    svn_prompt_info
  elif (( ${+functions[in_hg]} )) && in_hg; then
    hg_prompt_info
  else
    git_prompt_info
  fi
}

PROMPT='%2~ $(vcs_status)»%b '
